    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/jest": "29.5.14",
    "@types/nodemailer": "^8.0.1",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.14",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-web-browser": "~56.0.5",
    "i18next": "^26.3.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "lucide-react-native": "^1.22.0",
    "nativewind": "^4.2.6",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "~19.2.2",
    "autoprefixer": "^10.5.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "jest --passWithNoTests",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:e2e:web": "playwright test",
    "test:e2e:web:ui": "playwright test --ui",
    "test:smoke:production": "E2E_SKIP_SERVER=true PRODUCTION_BASE_URL=${PRODUCTION_BASE_URL:-https://invohub.vercel.app} playwright test e2e/web/production-smoke.spec.ts",
    "test:smoke:production:curl": "bash scripts/smoke-production.sh",
    "test:e2e:ios": "bash scripts/test-maestro.sh ios",
    "test:e2e:android": "bash scripts/test-maestro.sh android",
    "test:e2e:mobile": "bash scripts/test-maestro.sh all",
    "test:all": "bash scripts/test-all.sh",
    "test:ci": "npm run typecheck && npm run test:unit && npm run test:e2e:web",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "auth:generate": "npx @better-auth/cli generate",
    "promote-admin": "node scripts/promote-admin.mjs",
    "create-test-user": "node scripts/create-test-user.mjs",
    "marketing": "node scripts/serve-marketing.mjs",
    "vercel-build": "expo export -p web && node scripts/copy-marketing-site.mjs && node scripts/prepare-server-pdf-deps.mjs && node scripts/verify-pdf-vendor.mjs",
    "assets:pdfkit-fonts": "mkdir -p assets/pdfkit-data && cp node_modules/pdfkit/js/data/*.afm assets/pdfkit-data/"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
