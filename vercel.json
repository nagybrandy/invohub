{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "framework": null,
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**, assets/pdfkit-data/**, node_modules/pdfkit/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders/run",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/nav-receipt-report",
      "schedule": "0 6 * * *"
    }
  ]
}
