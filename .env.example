# .env.example
# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (use the pooled connection string).
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Better Auth server secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Native auth backend URL. Web uses the current page origin automatically.
# Use http://localhost:8081 for local native dev, or your deployed URL for device testing.
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:8081

# Optional fixed server base URL. Leave unset so auth derives origin from each request.
# BETTER_AUTH_URL=https://invohub.vercel.app

# Optional comma-separated extra trusted origins for CORS / CSRF checks.
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com

# Gmail SMTP (never commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=
SMTP_FROM=hello@example.com

# Vercel cron auth for reminder processing and the nav-receipt-report cron.
CRON_SECRET=

# Demo data seeding (app/api/dev/seed+api.ts). Never set ALLOW_DEV_SEED=true in
# production — the route is disabled there regardless. EXPO_PUBLIC_ALLOW_DEV_SEED
# only controls whether the Settings screen shows the "load demo data" button.
ALLOW_DEV_SEED=
EXPO_PUBLIC_ALLOW_DEV_SEED=

# Payment provider keys (stub until live)
REVOLUT_API_KEY=
BARION_POS_KEY=

# NAV M2M (teszt: m2m-dev.nav.gov.hu) — server-only, never commit real values
M2M_ENV=test
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=
M2M_USERNAME=
M2M_PASSWORD=
M2M_SIGNATURE_KEY_FIRST=
M2M_NONCE=

# --- NAV Online Számla (invoice reporting) ---------------------------------
# See docs/nav-test-setup.md for the exact owner setup steps.

# 18-character NAV-registered software id (letters/digits only). Required
# for every real (test or production) NAV call — demo mode doesn't need it.
NAV_SOFTWARE_ID=

# Optional software identity shown to NAV (defaults are sensible).
# NAV_SOFTWARE_VERSION=1.0.0
# NAV_SOFTWARE_DEV_NAME=InvoHub
# NAV_SOFTWARE_DEV_CONTACT=tech@invohub.hu
# NAV_SOFTWARE_DEV_TAX_NUMBER=

# Hard kill switch for the "production" NAV mode. Leave unset/false — every
# company falls back to demo mode if it's ever set to "production" while
# this is not exactly "true".
NAV_PRODUCTION_ENABLED=false

# AES-256-GCM key used to encrypt NAV technical secrets (technical password,
# XML sign key, exchange key) at rest. Required before any company can save
# NAV test/production credentials. Generate with: openssl rand -base64 32
NAV_CREDENTIALS_KEY=

# Shared InvoHub NAV TEST technical user (configure ONCE here so users can
# pick "NAV teszt (közös fiók)" without entering their own credentials).
# Never commit real values. See docs/nav-test-setup.md.
NAV_TEST_LOGIN=
NAV_TEST_PASSWORD=
NAV_TEST_SIGN_KEY=
NAV_TEST_CHANGE_KEY=
NAV_TEST_TAX_NUMBER=
