# .env.example
# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (use the pooled connection string).
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Better Auth server secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Native auth backend URL. Web uses the current page origin automatically.
# Use http://localhost:8081 for local native dev, or your deployed URL for device testing.
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:8081

# Optional fixed server base URL. Leave unset so auth derives origin from each request.
# BETTER_AUTH_URL=https://invohub.vercel.app

# Optional comma-separated extra trusted origins for CORS / CSRF checks.
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com

# Gmail SMTP (never commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=
SMTP_FROM=hello@example.com

# Vercel cron auth for reminder processing and the nav-receipt-report cron.
CRON_SECRET=

# Demo data seeding (app/api/dev/seed+api.ts). Never set ALLOW_DEV_SEED=true in
# production — the route is disabled there regardless. EXPO_PUBLIC_ALLOW_DEV_SEED
# only controls whether the Settings screen shows the "load demo data" button.
ALLOW_DEV_SEED=
EXPO_PUBLIC_ALLOW_DEV_SEED=

# Payment provider keys (stub until live)
REVOLUT_API_KEY=
BARION_POS_KEY=

# NAV M2M (teszt: m2m-dev.nav.gov.hu) — server-only, never commit real values
M2M_ENV=test
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=
M2M_USERNAME=
M2M_PASSWORD=
M2M_SIGNATURE_KEY_FIRST=
M2M_NONCE=
